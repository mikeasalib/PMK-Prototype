# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Local env — never commit
.env

# Scratchpad raw MCP dumps — not the scripts, just the transient payloads.
# The refresh script (scratchpad/build-snapshots.py) is checked in so a
# refresh is reproducible; the *.raw.json files it consumes are not, since
# they change every time we re-pull.
scratchpad/*.raw.json

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated artifact drafts — not source
.artifacts/
